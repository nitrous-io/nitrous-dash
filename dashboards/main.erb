<% content_for :title do %>Nitrous Main Dashboard<% end %>

<div class="gridster">
  <ul>
    <li data-row="1" data-col="1" data-sizex="1" data-sizey="1">
      <div data-id="users_1_day" data-view="Number" data-title="Last 24hrs"></div>
    </li>
    <li data-row="1" data-col="2" data-sizex="1" data-sizey="1">
      <div data-id="users_30_day" data-view="Number" data-title="30 day"></div>
    </li>
    <li data-row="1" data-col="3" data-sizex="1" data-sizey="1">
      <div data-id="users_total" data-view="Number" data-title="Total"></div>
    </li>

    <li data-row="1" data-col="4" data-sizex="1" data-sizey="1">
      <div data-id="users_active" data-view="Number" data-title="30 day Active"></div>
    </li>

    <li data-row="2" data-col="1" data-sizex="4" data-sizey="1">
      <div data-view="Clock"></div>
    </li>
  </ul>
</div>
