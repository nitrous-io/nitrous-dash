<% content_for :title do %>Nitrous Ops Dashboard<% end %>

<div class="gridster">
  <ul>
    <li data-row="1" data-col="1" data-sizex="1" data-sizey="1">
      <div data-id="free_instances_running" data-view="Number" data-title="Free: Running"></div>
    </li>
    <li data-row="1" data-col="1" data-sizex="1" data-sizey="1">
      <div data-id="free_instances_stopped" data-view="Number" data-title="Free: Stopped"></div>
    </li>
    <li data-row="1" data-col="2" data-sizex="1" data-sizey="1">
      <div data-id="paid_instances_running" data-view="Number" data-title="Paid: Running"></div>
    </li>
    <li data-row="2" data-col="1" data-sizex="4" data-sizey="1">
      <div data-view="Clock"></div>
    </li>
  </ul>
</div>
